calc_rMSE <- function(alpha,estimate) {
  n <- length(alpha)
  rMSE <- 0
  for(i in 1:n){
    rMSE <- rMSE + (estimate[i] - alpha[i])^2
  }
  rMSE <- sqrt(rMSE/n)
  return(rMSE)
}

